<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="settings" />
        <include domain="database" path="tenniscount.db" />
        <exclude domain="file" path="model-ru/" />
        <exclude domain="file" path="model-ru.staging/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="settings" />
        <include domain="database" path="tenniscount.db" />
        <exclude domain="file" path="model-ru/" />
        <exclude domain="file" path="model-ru.staging/" />
    </device-transfer>
</data-extraction-rules>
